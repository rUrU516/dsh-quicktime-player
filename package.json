{
  "name": "dsh-quicktime-player",
  "version": "0.4.0",
  "description": "Sidebar video player for DeepSeek Harness: streaming playback with seek, wheel zoom, drag pan and a custom control bar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rUrU516/dsh-quicktime-player.git"
  },
  "homepage": "https://github.com/rUrU516/dsh-quicktime-player#readme",
  "bugs": {
    "url": "https://github.com/rUrU516/dsh-quicktime-player/issues"
  },
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/screenshot.jpg",
    "scripts/make-icon.mjs"
  ],
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "preview",
    "player"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
